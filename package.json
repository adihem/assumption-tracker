{
  "name": "assumption-tracker",
  "version": "1.0.0",
  "private": true,
  "description": "Pi coding-agent extension that records the agent's unstated assumptions for human review, persists decisions in the session, and tells the agent about them.",
  "keywords": [
    "pi",
    "pi-extension",
    "coding-agent",
    "ai-agents",
    "human-in-the-loop",
    "assumptions"
  ],
  "author": "adihem",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/adihem/assumption-tracker.git"
  },
  "homepage": "https://github.com/adihem/assumption-tracker#readme",
  "bugs": {
    "url": "https://github.com/adihem/assumption-tracker/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "pi": "pi -na -e ./.pi/extensions/assumption-tracker.ts",
    "smoke": "node scripts/smoke.mjs",
    "e2e": "node scripts/e2e-review.mjs",
    "extract": "node scripts/extract-session.mjs",
    "pi:baseline": "pi -na"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "1.3.0",
    "@earendil-works/pi-coding-agent": "1.3.0",
    "typebox": "1.4.2"
  }
}
